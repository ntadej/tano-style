{
  "name": "@ntadej/style",
  "version": "0.6.0",
  "description": "Common infrastructure for tano.si webpages",
  "license": "MIT",
  "author": "Tadej Novak <tadej@tano.si>",
  "homepage": "https://github.com/ntadej/tano-style#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntadej/tano-style.git"
  },
  "scripts": {
    "prepare": "husky",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check . --log-level warn",
    "lint:ts": "tsc --noEmit --declaration",
    "dev": "next dev --turbopack",
    "build": "next build"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "clsx": "^2.1.1",
    "next": "~16.2.6",
    "next-themes": "^0.4.6",
    "react": "~19.2.6",
    "react-dom": "~19.2.6",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.8.0",
    "@types/react": "~19.2.14",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "~16.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "postcss": "^8.5.14",
    "prettier": "3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "~0.8.0",
    "tailwindcss": "~3.4.19",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{cjs,css,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
